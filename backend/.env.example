# HTTP server configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
# Separate multiple allowed browser origins with commas.

# Generate a unique random value (at least 32 characters) for each environment.
SESSION_SECRET=replace-with-a-long-random-secret-not-committed-to-git

# MongoDB connection configuration
# MONGODB_URI is preferred. MONGO_URI is supported for existing deployments.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
